# SCP Anomaly Tracker - Environment Variables
# Copy this file to .env and update with your actual values

# API Configuration
# The base URL for the SCP database API
# Default (if not set): https://sba-319-mongodb-database-application-scp.onrender.com
# Local development example:
VITE_API_URL=http://localhost:3000

# Production example:
# VITE_API_URL=https://your-scp-api-domain.com